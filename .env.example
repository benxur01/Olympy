# Development:
VITE_API_BASE_URL=http://localhost:8000

# Production:
# If frontend and backend are served from the same domain, this can be omitted.
# If backend is separate, set the exact backend origin, for example:
# VITE_API_BASE_URL=https://api.yourdomain.com

# Web Push (VAPID) public key. Must match the backend's VAPID_PUBLIC_KEY —
# if the pair is rotated on the backend and this is left stale, subscriptions
# still register but notifications are never delivered.
# VITE_VAPID_PUBLIC_KEY=

# Google OAuth client id (Google Identity Services).
# VITE_GOOGLE_CLIENT_ID=
