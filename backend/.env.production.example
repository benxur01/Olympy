# ═══════════════════════════════════════════════════════════════════════════
# Olympy — Contabo VPS (Docker Compose) uchun muhit o'zgaruvchilari namunasi.
#
# Ishlatish:
#   cp backend/.env.production.example backend/.env
#   nano backend/.env        # CHANGE_ME deb yozilgan joylarni to'ldiring
#
# Bu FAYL — namuna (repoda saqlanadi). `backend/.env` esa .gitignore'da va
# HECH QACHON commit qilinmaydi.
#
# Bitta fayl uchta xizmatga xizmat qiladi (docker-compose.yml `env_file:`):
# backend (gunicorn), celery-worker, celery-beat — va postgres konteyneri shu
# yerdan POSTGRES_* larni oladi.
#
# Lokal development uchun to'liq ro'yxat va izohlar: backend/.env.example
# ═══════════════════════════════════════════════════════════════════════════

# ─── Django asosiy sozlamalari ─────────────────────────────────────────────
# Yangi kalit generatsiya qilish:
#   docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(64))"
# DIQQAT: Render'dagi kalitni AYNAN ko'chirsangiz mavjud sessiyalar va
# shifrlangan 2FA kalitlari ishlashda davom etadi. Yangi kalit qo'ysangiz
# barcha foydalanuvchilar qayta login qilishga majbur bo'ladi.
OLYMPY_SECRET_KEY=CHANGE_ME_SECRET_KEY
OLYMPY_DEBUG=False

# Domen(lar). 127.0.0.1 va localhost ATAYIN ro'yxatda: docker-compose.yml
# dagi backend healthcheck konteyner ichidan http://127.0.0.1:8000/api/health/
# ni so'raydi va Host ro'yxatda bo'lmasa Django 400 (DisallowedHost) qaytarib
# konteyner "unhealthy" bo'lib qolardi.
OLYMPY_ALLOWED_HOSTS=CHANGE_ME.uz,www.CHANGE_ME.uz,127.0.0.1,localhost
# Frontend va API endi BITTA domenda (nginx ikkalasini ham beradi), ya'ni
# amalda cross-origin so'rov yo'q. Ro'yxat baribir to'ldiriladi: settings.py
# production'da bo'sh ro'yxatni rad etadi.
OLYMPY_CORS_ALLOWED_ORIGINS=https://CHANGE_ME.uz
OLYMPY_CSRF_TRUSTED_ORIGINS=https://CHANGE_ME.uz

# TLS HALI YO'Q PAYTDA 0 QOLDIRING. Sertifikatsiz 1 qilinsa Django har
# so'rovni https'ga yo'naltiradi va sayt ochilmaydi (nginx 80-portda,
# X-Forwarded-Proto=http). Let's Encrypt sertifikati olinib, nginx'da 443
# yoqilgandan keyin 1 qiling va backend'ni qayta ishga tushiring.
OLYMPY_SECURE_SSL_REDIRECT=0
# HSTS ni ham sertifikat olingandan keyin yoqing (31536000 = 1 yil).
# Brauzer HSTS'ni faqat HTTPS ustidan qabul qiladi, ammo noto'g'ri
# konfiguratsiyada saytni uzoq muddatga "qulflab" qo'yishi mumkin.
OLYMPY_SECURE_HSTS_SECONDS=0

# Nginx — bitta reverse proxy. DRF throttling haqiqiy klient IP'sini
# X-Forwarded-For zanjiridan shu son bo'yicha oladi.
NUM_PROXIES=1

# Bildirishnomalardagi (Telegram/email) havolalar shu manzildan quriladi.
SITE_URL=https://CHANGE_ME.uz
OLYMPY_FRONTEND_URL=https://CHANGE_ME.uz

# Ixtiyoriy: frontend va API bitta domenda bo'lgani uchun JWT cookie'lari
# uchun SameSite=None shart emas. Lax qat'iyroq (CSRF yuzasi kichikroq).
# Faqat TLS ishlaganini va login oqimini tekshirgandan KEYIN yoqing.
# OLYMPY_JWT_COOKIE_SAMESITE=Lax

PROFILE_IMAGE_MAX_BYTES=5242880
CENTER_IMAGE_MAX_BYTES=5242880

# 2FA (TOTP) kalitlarini DB'da shifrlash uchun. Render'da o'rnatilgan bo'lsa
# AYNAN o'sha qiymatni ko'chiring — aks holda mavjud 2FA kalitlari ochilmaydi
# va foydalanuvchilar 2FA'ni qayta sozlashi kerak bo'ladi.
TOTP_ENCRYPTION_KEY=
# Google Login (backend ID token tekshiruvi).
GOOGLE_CLIENT_ID=

# ─── PostgreSQL (postgres konteyneri) ──────────────────────────────────────
# Bu uchtasini postgres konteyneri BIRINCHI ishga tushganda ishlatadi (bazani
# va foydalanuvchini yaratadi). Keyinchalik o'zgartirilsa ta'sir qilmaydi —
# volume'dagi mavjud baza saqlanib qoladi.
POSTGRES_DB=olympy
POSTGRES_USER=olympy
POSTGRES_PASSWORD=CHANGE_ME_DB_PAROL

# Django shu URL orqali ulanadi. `postgres` — docker-compose.yml dagi xizmat
# nomi (Docker ichki DNS), localhost EMAS.
# MUHIM: paroli yuqoridagi POSTGRES_PASSWORD bilan AYNAN bir xil bo'lsin.
# Parolda maxsus belgi bo'lsa URL-encode qiling (@ → %40, # → %23).
DATABASE_URL=postgres://olympy:CHANGE_ME_DB_PAROL@postgres:5432/olympy

# PostgreSQL schema. Bo'sh qoldiring — VPS'dagi baza faqat Olympy uchun,
# `public` schema yetarli. Render'da bazani boshqa loyiha bilan baham
# ko'rgan va DATABASE_SCHEMA o'rnatilgan bo'lsa, dump ham o'sha schema bilan
# keladi — bunda AYNAN o'sha nomni yozing (release qadami schema'ni yaratadi).
DATABASE_SCHEMA=

# ─── Redis (redis konteyneri) ──────────────────────────────────────────────
# `redis` — docker-compose.yml dagi xizmat nomi. Bitta URL uch joyda
# ishlatiladi: Django cache (rate limit, lockout), Celery broker va result.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND_URL=
# Production'da HECH QACHON true qilmang — task'lar HTTP so'rov ichida
# sinxron bajarilib serverni qotiradi.
CELERY_EAGER=false

# ─── Jarayon sozlamalari (Docker) ──────────────────────────────────────────
# Har gunicorn worker butun Django ilovaning yana bir nusxasini xotiraga
# yuklaydi (~250-350MB). Render'da 512MB limit sababli 1 ta edi; VPS RAM'iga
# qarab tanlang: 2GB → 1-2, 4GB → 2, 8GB+ → 3-4.
GUNICORN_WORKERS=2
GUNICORN_THREADS=6
# Celery worker parallelligi (og'ir task'lar: AI tahlil, PDF, sertifikat).
CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL=info
# `release` qadami DB'ni necha soniya kutadi (birinchi ishga tushirishda
# Postgres initdb biroz vaqt oladi).
DB_WAIT_TIMEOUT=90

# ─── Media saqlash ─────────────────────────────────────────────────────────
# VPS'da Render'dan farqli o'laroq PERSISTENT disk bor: docker-compose.yml
# dagi `media_data` volume restart va deploy'larda saqlanadi, nginx uni
# /media/ orqali beradi. Ya'ni Cloudinary endi MAJBURIY emas.
#
# Tavsiya: Render'da Cloudinary ishlatilgan bo'lsa, shu qiymatlarni AYNAN
# ko'chiring. Aks holda mavjud avatar/logo URL'lari (DB'da Cloudinary
# manzillari saqlangan) ishlashda davom etadi, lekin yangi yuklamalar lokal
# volume'ga tushib, ikki xil manba aralashib ketadi.
# Bo'sh qoldirilsa — hamma media lokal volume'da (backup rejasini o'ylang!).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Telegram botlar ───────────────────────────────────────────────────────
# Qiymatlarni Render dashboard'idan ko'chiring.
# DIQQAT: TELEGRAM_AUTH_BOT_TOKEN bo'sh QOLDIRILSA, settings.py dagi
# "TELEGRAM_BOT_TOKEN ga fallback" ISHLAMAYDI — bo'sh satr ham qiymat
# hisoblanadi. Bitta bot ishlatsangiz TELEGRAM_BOT_TOKEN ni to'ldiring va
# AUTH/MANAGER qatorlarini o'chiring yoki izohga oling.
# DIQQAT (cutover): DNS ko'chgandan keyin webhook manzillarini yangilash SHART:
#   https://api.telegram.org/bot$TOKEN/setWebhook?url=https://DOMEN/api/telegram/webhook/auth/&secret_token=$SECRET
#   https://api.telegram.org/bot$TOKEN/setWebhook?url=https://DOMEN/api/telegram/webhook/manager/&secret_token=$SECRET
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_AUTH_BOT_TOKEN=
TELEGRAM_AUTH_BOT_USERNAME=
TELEGRAM_MANAGER_BOT_TOKEN=
TELEGRAM_MANAGER_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_AUTH_WEBHOOK_SECRET=
TELEGRAM_MANAGER_WEBHOOK_SECRET=
PHONE_VERIFICATION_OTP_TTL_SECONDS=300
PHONE_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_OTP_TTL_SECONDS=900
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# ─── Email (Mailgun / anymail) ─────────────────────────────────────────────
# MAILGUN_API_KEY bo'sh bo'lsa console backend ishlaydi (xat yuborilmaydi).
#
# EMAIL_BACKEND va MAILGUN_SENDER_DOMAIN ATAYIN IZOHDA: settings.py ularni
# `os.environ.get(nom, DEFAULT)` bilan o'qiydi, ya'ni BO'SH satr ham qiymat
# hisoblanadi va default'ni bekor qiladi (EMAIL_BACKEND='' bo'lsa xat
# yuborishda ImportError). Render'da o'rnatilmagan o'zgaruvchi umuman
# yo'q edi — env_file'da esa `NOM=` yozilishi uni BO'SH qilib o'rnatadi.
# Kerak bo'lsa izohdan chiqarib to'ldiring, aks holda TEGMANG.
# EMAIL_BACKEND=anymail.backends.mailgun.EmailBackend
# MAILGUN_SENDER_DOMAIN=CHANGE_ME.uz
MAILGUN_API_KEY=
DEFAULT_FROM_EMAIL=Olympy <noreply@CHANGE_ME.uz>

# ─── Web Push (VAPID) ──────────────────────────────────────────────────────
# Bo'sh bo'lsa push xabarnomalar jimgina o'chadi. Mavjud obunalar ishlashi
# uchun Render'dagi AYNAN o'sha juftlikni ko'chiring (kalit o'zgarsa barcha
# obunalar yaroqsiz bo'ladi).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:admin@CHANGE_ME.uz

# ─── Monitoring ────────────────────────────────────────────────────────────
SENTRY_DSN=
DJANGO_ENV=production
# /api/health/ batafsil javobini (db/redis/celery holati) ochish uchun token.
# Bo'sh bo'lsa faqat {"status": "ok"} qaytadi.
HEALTH_CHECK_TOKEN=

# ─── AI (Gemini) ───────────────────────────────────────────────────────────
GEMINI_API_KEY=
AI_ROSTER_GEMINI_API_KEYS=
AI_ROSTER_GEMINI_MODEL=gemini-2.5-flash
AI_ROSTER_AUTO_APPROVE=False
AI_ROSTER_ALLOW_NAME_ONLY_APPROVAL=1
AI_ROSTER_MIN_CONFIDENCE=0.98
AI_MANAGER_BOT_GEMINI_API_KEY=
AI_MANAGER_BOT_GEMINI_MODEL=gemini-2.5-flash
AI_QUESTION_GEMINI_API_KEY=
AI_QUESTION_GEMINI_MODEL=gemini-2.5-flash
AI_QUESTION_MAX_COUNT=30
# Bu limit nginx `client_max_body_size 25m` dan KICHIK bo'lishi kerak
# (nginx/nginx.conf) — aks holda foydalanuvchi Django xatosi o'rniga
# nginx'ning 413 sahifasini ko'radi.
AI_QUESTION_PDF_MAX_BYTES=20971520

# ─── Judge0 (kod runner) ───────────────────────────────────────────────────
# JUDGE0_URL ham IZOHDA (yuqoridagi EMAIL_BACKEND bilan bir xil sabab):
# bo'sh qoldirilsa settings.py dagi default 'https://ce.judge0.com' bekor
# bo'ladi va kod ishga tushirish umuman ishlamay qoladi.
# JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=

# ─── To'lov tizimi ─────────────────────────────────────────────────────────
# DIQQAT (cutover): Payme va Click kabinetlarida webhook (callback) URL'larini
# yangi domenga o'zgartirishni unutmang.
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
MANAGER_COMMISSION_RATE=0.20
FREE_OLYMPIAD_MONTHLY_LIMIT=2
OLYMPY_SUPPORT_CONTACT=
TRIAL_SUBSCRIPTION_DAYS=14
ACCOUNT_DELETE_GRACE_DAYS=30

# ─── Bootstrap (birinchi ishga tushirish) ──────────────────────────────────
# `release` qadami ensure_platform_admin / ensure_manager / ensure_center_owner
# ni chaqiradi. Qiymatlar bo'sh bo'lsa ular JIMGINA o'tkazib yuboriladi.
#
# Render bazasini restore qilsangiz BO'SH QOLDIRING — barcha hisoblar dump
# ichida keladi. Faqat noldan boshlanayotgan bo'lsa admin qatorlarini
# to'ldiring (parol o'rnatilgach, bu qiymatlarni .env dan olib tashlash tavsiya
# etiladi — har release'da parol qayta o'rnatiladi).
OLYMPY_BOOTSTRAP_ADMIN_PHONE=
OLYMPY_BOOTSTRAP_ADMIN_PASSWORD=
OLYMPY_BOOTSTRAP_ADMIN_FULL_NAME=Platform Admin
OLYMPY_BOOTSTRAP_MANAGER_PHONE=
OLYMPY_BOOTSTRAP_MANAGER_PASSWORD=
OLYMPY_BOOTSTRAP_OWNER_PHONE=
OLYMPY_BOOTSTRAP_OWNER_PASSWORD=
OLYMPY_BOOTSTRAP_OWNER_CENTER=
OLYMPY_BOOTSTRAP_OWNER_CITY=Toshkent
